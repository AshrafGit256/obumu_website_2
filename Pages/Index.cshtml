                                            <div class="bank-badge-logo"><img src="/assets/images/Absa_Logo.svg" alt="Absa Bank" /></div>
                                            <div class="bank-badge-logo"><img src="/assets/images/equity-bank_logo.webp" alt="Equity Bank" /></div>
