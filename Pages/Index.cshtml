@page
@model IndexModel
@{
  Layout = null;
  ViewData["Title"] = "Obumu is Contribution & Pledge Platform";
  ViewData["ActiveNav"] = "home";
}
<!DOCTYPE html>
<html lang="en">

<head>
  <partial name="_Head" />
</head>

<body class="home-page">

  <partial name="_Nav" />

  <!-- HERO -->
