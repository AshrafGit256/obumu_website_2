                 aria-label="Events Obumu helps fund">
              <div class="event-slider-track" id="eventSliderTrack">
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/events/introductions.png" alt="Nalwanga Introduction" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Nalwanga's Introduction</h3>
                    <p class="event-slide-sub">OBUMU simplifies funding for Traditional Ceremonies.</p>
                  </div>
                </div>
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/old_house.png" alt="Old House" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Grandpa's House Renovation</h3>
                    <p class="event-slide-sub">Rennovation fundraises are made easier with OBUMU</p>
                  </div>
                </div>
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/events/burial.png" alt="Bukenya's Burial" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Bukenya's burial</h3>
                    <p class="event-slide-sub">Burial fundraises are made easier with </p>
                  </div>
                </div>
                <div class="event-slide" role="group" aria-roledescription="slide" aria-label="2 of 7">
                  <img src="/assets/images/events/clean_water.jpg" alt="Ndejje primary school borehole fundraise"
                       loading="lazy" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Ndejje Primary School Borehole Fundraise</h3>
                    <p class="event-slide-sub">OBUMU is a solution to collect money for problems affecting communities.</p>
                  </div>
                </div>
                
              </div>
              <button class="event-slider-arrow prev" id="eventPrev" aria-label="Previous event">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                  <path d="M12.5 4.5 6 10l6.5 5.5" />
                </svg>
              </button>
              <button class="event-slider-arrow next" id="eventNext" aria-label="Next event">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                  <path d="m7.5 4.5 6.5 5.5-6.5 5.5" />
                </svg>
              </button>
              <div class="event-slider-dots" id="eventDots">
                <button class="event-dot is-active" data-slide="0" aria-label="Go to slide 1"></button>
                <button class="event-dot" data-slide="1" aria-label="Go to slide 2"></button>
                <button class="event-dot" data-slide="2" aria-label="Go to slide 3"></button>
                <button class="event-dot" data-slide="3" aria-label="Go to slide 4"></button>
              </div>
            </div>
            <div class="hero-stat-card glass-card">
              <div class="hero-stat-icon">
                <svg viewBox="0 0 22 22" fill="none">
                  <path d="M11 2a9 9 0 100 18A9 9 0 0011 2Z" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </div>
              <div class="hero-stat-card-text">
                <strong>100% secure</strong>
                <!---<span>MTN &amp; Airtel Money</span> -->
              </div>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- OBUMU SLIDER -->
    <section class="obumu-strip" id="showcase" aria-label="Obumu highlights">
      <div class="wrap obumu-strip-inner">
        <div class="obumu-strip-side obumu-strip-side-prev" id="obumuStripPrev" aria-hidden="true">
          <img class="obumu-strip-side-image" id="obumuStripPrevImage" src="/assets/images/people_looking_at_the_phone.png" alt="" />
          <div class="obumu-strip-side-copy">
            <span class="obumu-strip-side-kicker">Previous</span>
            <strong id="obumuStripPrevTitle">Share with your group</strong>
            <p id="obumuStripPrevDesc">One link, easy for everyone to join.</p>
          </div>
        </div>
        <div class="obumu-strip-media">
          <img id="obumuStripImage" class="obumu-strip-image is-active" src="/assets/images/obumu_on_mobile.png" alt="Obumu on mobile" loading="eager" />
        </div>
        <div class="obumu-strip-copy">
          <span class="obumu-strip-kicker">OBUMU</span>
          <h2 class="obumu-strip-title" id="obumuStripTitle">Use Obumu on your phone</h2>
          <p class="obumu-strip-desc" id="obumuStripDesc">Collect, contribute, and pledge in a few taps.</p>
        </div>
        <div class="obumu-strip-side obumu-strip-side-next" id="obumuStripNext" aria-hidden="true">
          <img class="obumu-strip-side-image" id="obumuStripNextImage" src="/assets/images/fundraisers.png" alt="" />
          <div class="obumu-strip-side-copy">
            <span class="obumu-strip-side-kicker">Next</span>
            <strong id="obumuStripNextTitle">Keep every fundraiser clear</strong>
            <p id="obumuStripNextDesc">See money and pledges as they come in.</p>
          </div>
        </div>
        <div class="obumu-strip-slides" id="obumuStripSlides" hidden>
          <div data-image="/assets/images/obumu_on_mobile.png" data-alt="Obumu on mobile" data-title="Use Obumu on your phone" data-desc="Collect, contribute, and pledge in a few taps."></div>
          <div data-image="/assets/images/people_looking_at_the_phone.png" data-alt="People looking at the phone" data-title="Share with your group" data-desc="One link, easy for everyone to join."></div>
          <div data-image="/assets/images/fundraisers.png" data-alt="Fundraisers" data-title="Keep every fundraiser clear" data-desc="See money and pledges as they come in."></div>
        </div>
      </div>
    </section>

    <!-- INTERCEPT -->
    <div class="intercept" id="promise">
      <div class="intercept-inner wrap-xs">
        <h2>Built for Uganda,<br><em>made for your community.</em></h2>
        <p class="intercept-pull">Obumu gives every community in Uganda a simple, honest way to collect money and manage
          pledges with full visibility into every payment.</p>
          <a href="http://209.209.42.109:5106/Obumu/Accounts/Register" class="btn btn-blue btn-lg">Create your account</a>
        </div>
      </div>

      <!-- HOW IT WORKS 3 steps -->
      <section class="how-section" id="how">
        <div class="wrap">
          <div class="how-header" data-r>
            <span class="eyebrow">How it works</span>
            <h2 class="display-sm" style="max-width:560px;margin:0 auto 16px">Three steps.<br><em>Done.</em></h2>
            <p class="lead" style="text-align:center;margin:0 auto;max-width:520px">Set up your collection, receive
              contributions and pledges, then get paid all in one place.</p>
            </div>
            <div class="how-cols">
              <div class="how-col" data-r="l">
                <div class="how-col-num">01</div>
                <div class="how-col-icon">
                  <svg viewBox="0 0 40 40" fill="none">
                    <rect x="5" y="7" width="30" height="26" rx="4" stroke="currentColor" stroke-width="1.8" />
                    <path d="M13 3v8M27 3v8M5 18h30M13 26h14M13 31h8" stroke="currentColor" stroke-width="1.8"
                          stroke-linecap="round" />
                  </svg>
                </div>
                <h3>Create your collection</h3>
                <p>Set up your event in under 2 minutes. Add a name, goal, and date. Obumu gives you a link to share right
                  away.</p>
                  <ul class="how-col-list">
                    <li>Event name &amp; goal amount</li>
                    <li>Shareable payment link</li>
                    <li>Live in 2 minutes</li>
                  </ul>
                </div>
                <div class="how-col" data-r>
                  <div class="how-col-num">02</div>
                  <div class="how-col-icon">
                    <svg viewBox="0 0 40 40" fill="none">
                      <rect x="4" y="10" width="32" height="22" rx="4" stroke="currentColor" stroke-width="1.8" />
                      <path d="M4 17h32" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      <circle cx="12" cy="27" r="2.5" stroke="currentColor" stroke-width="1.6" />
                      <path d="M19 25h10M19 29h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  </div>
                  <h3>Receive money &amp; pledges</h3>
                  <p>People pay via MTN MoMo, Airtel, or Visa. Pledgers commit now and pay later Obumu sends them reminders so
                    you never have to ask.</p>
                    <ul class="how-col-list">
                      <li>MTN, Airtel &amp; Visa</li>
                      <li>Pledge reminders automatic</li>
                      <li>Live progress dashboard</li>
                    </ul>
                  </div>
                  <div class="how-col" data-r="r">
                    <div class="how-col-num">03</div>
                    <div class="how-col-icon">
                      <svg viewBox="0 0 40 40" fill="none">
                        <path d="M20 5L4 13v10c0 8 7 14 16 16 9-2 16-8 16-16V13L20 5Z" stroke="currentColor" stroke-width="1.8"
                              stroke-linejoin="round" />
                        <path d="M13 20l5 5 9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" />
                      </svg>
                    </div>
                    <h3>Get paid instantly</h3>
                    <p>Money lands straight on your MTN or Airtel account. No forms, no waiting. Every payout comes with a full
                      receipt for everyone.</p>
                      <ul class="how-col-list">
                        <li>Instant mobile money payout</li>
                        <li>Receipts for all parties</li>
                        <li>Full payment history</li>
                      </ul>
                    </div>
                  </div>

                  <!-- Live dashboard mockup -->
                  <div class="how-dashboard glass-card-dark" data-r>
                    <div class="how-db-head">
                      <div class="how-db-badge">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                          <rect x="1" y="3" width="14" height="11" rx="2" />
                          <path d="M1 7h14M5 1v4M11 1v4" />
                        </svg>
                        Live Dashboard
                      </div>
                      <span class="how-db-live"><span class="pill-dot" style="width:6px;height:6px"></span>Live</span>
                    </div>
                    <div class="how-db-grid">
                      <div class="how-db-stat"><span class="how-db-stat-lbl">Total collected</span><span
                        class="how-db-stat-val orange">UGX 13,600,000</span></div>
                        <div class="how-db-stat"><span class="how-db-stat-lbl">Contributors</span><span
                          class="how-db-stat-val">312</span></div>
                          <div class="how-db-stat"><span class="how-db-stat-lbl">Pledged</span><span class="how-db-stat-val">UGX
                            4,200,000</span></div>
                            <div class="how-db-stat"><span class="how-db-stat-lbl">Goal</span><span class="how-db-stat-val">UGX
                              20,000,000</span></div>
                            </div>
                            <div class="how-bar-wrap" style="margin-top:12px">
                              <div class="how-bar-lbl"><span>Collection progress</span><span
                                style="color:var(--orange);font-weight:700">68%</span></div>
                                <div class="how-bar-track">
                                  <div class="how-bar-fill" style="width:68%"></div>
                                </div>
                              </div>
                              <div class="how-ui-badge success" style="margin-top:16px">âœ“ Payout on the way</div>
                            </div>
                          </div>
                        </section>

                        <!-- APP SECTION webapp + mobile mockups -->
