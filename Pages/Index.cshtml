                                      <div class="webapp-main">
                                        <div class="webapp-main-title">Collections overview</div>
                                        <div class="webapp-stats-row">
                                          <div class="webapp-stat-card"><span class="webapp-stat-val orange">UGX 47.2M</span><span
                                            class="webapp-stat-lbl">Total collected</span></div>
                                            <div class="webapp-stat-card"><span class="webapp-stat-val">1,240</span><span
                                              class="webapp-stat-lbl">Contributors</span></div>
                                              <div class="webapp-stat-card"><span class="webapp-stat-val green">UGX 8.4M</span><span
                                                class="webapp-stat-lbl">Pledged</span></div>
                                              </div>
                                              <div class="webapp-table-head"><span>Event</span><span>Collected</span><span>Status</span></div>
                                              <div class="webapp-table-row"><span>Nalwanga Intro</span><span class="hi-orange">13.6M</span><span
                                                class="badge-active">Active</span></div>
                                                <div class="webapp-table-row"><span>Ssemanda Burial</span><span>9.1M</span><span class="badge-done">Paid
                                                  out</span></div>
                                                  <div class="webapp-table-row dim"><span>Gulu School</span><span>26.5M</span><span
                                                    class="badge-active">Active</span></div>
                                                  </div>
                                                </div>
                                              </div>
                                              <!-- Mobile mockup floating -->
                                              <div class="mobile-float glass-card">
                                                <div class="mobile-float-notch"></div>
                                                <div class="mobile-float-screen">
                                                  <div class="mobile-float-title">Nalwanga Introduction</div>
                                                  <div class="mobile-float-amount hi-orange">UGX 13,600,000</div>
                                                  <div class="mobile-float-sub">collected of UGX 20M goal</div>
                                                  <div class="how-bar-track" style="margin:10px 0 6px">
                                                    <div class="how-bar-fill" style="width:68%"></div>
                                                  </div>
                                                  <div style="font-size:.65rem;color:rgba(255,255,255,.45);margin-bottom:10px">312 contributors Â· 48 pledges
                                                  </div>
                                                  <div class="mobile-float-btn">Pay now MTN MoMo</div>
                                                </div>
                                              </div>
                                            </div>
                                          </div>
                                        </div>
                                      </section>

                                      <!-- FEATURES -->
                                      <section class="features-section" id="features">
