@page
@model IndexModel
@{
  Layout = null;
  ViewData["Title"] = "Obumu is Contribution & Pledge Platform";
  ViewData["ActiveNav"] = "home";
}
<!DOCTYPE html>
<html lang="en">

<head>
  <partial name="_Head" />
</head>

<body class="home-page">

  <partial name="_Nav" />

  <!-- HERO -->
  <section class="hero" style="--hero-img:url('/assets/images/events/togetherness.png')">
    @* <div class="hero-blob"></div> *@
    <div class="hero-main wrap">
      <div class="hero-left">
        <h1>Manage your contributions.<br><span>Track pledges.</span></h1>
        <p class="hero-sub">
          Obumu is a platform for community contributions and pledges.
          <strong>Reliable, secure, and affordable.</strong>
        </p>
        <div class="hero-cta">
          <a href="http://209.209.42.109:5106/Obumu/Accounts/Register" class="btn btn-orange btn-lg">Get started
            free</a>
            <span class="hero-cta-aside">
              <svg viewBox="0 0 14 14" fill="none" stroke-width="1.6" stroke-linecap="round">
                <path d="M7 1a6 6 0 100 12A6 6 0 007 1Z" />
                <path d="M5 7l1.5 1.5L9.5 5" />
              </svg>
              Secure always
            </span>
          </div>
          <div class="hero-chips">
            <a href="#banks" class="hero-chip">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="10" width="18" height="10" rx="2" /><path d="M7 10V7a5 5 0 0 1 10 0v3" />
              </svg>
              Banks
            </a>
            <a href="#banks" class="hero-chip">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="2" /><path d="M12 18h.01" />
              </svg>
              Mobile Money
            </a>
          </div>
        </div>
        <div class="hero-right">
          <div class="hero-visual-wrap">
            <div class="hero-accent-bar"></div>
            <!-- <div class="hero-badge-top">
              <div class="hero-badge-top-num">25k+</div>
              <div class="hero-badge-top-lbl">Active users</div>
            </div>-->
            <!-- Events slider -->
            <div class="hero-img-main event-slider" id="eventSlider" aria-roledescription="carousel"
                 aria-label="Events Obumu helps fund">
              <div class="event-slider-track" id="eventSliderTrack">
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/events/introductions.png" alt="Nalwanga Introduction" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Nalwanga's Introduction</h3>
                    <p class="event-slide-sub">OBUMU simplifies funding for Traditional Ceremonies.</p>
                  </div>
                </div>
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/old_house.png" alt="Old House" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Grandpa's House Renovation</h3>
                    <p class="event-slide-sub">Rennovation fundraises are made easier with OBUMU</p>
                  </div>
                </div>
                <div class="event-slide is-active" role="group" aria-roledescription="slide" aria-label="1 of 7">
                  <img src="/assets/images/events/burial.png" alt="Bukenya's Burial" loading="eager" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Bukenya's burial</h3>
                    <p class="event-slide-sub">Burial fundraises are made easier with </p>
                  </div>
                </div>
                <div class="event-slide" role="group" aria-roledescription="slide" aria-label="2 of 7">
                  <img src="/assets/images/events/clean_water.jpg" alt="Ndejje primary school borehole fundraise"
                       loading="lazy" />
                  <div class="event-slide-overlay"></div>
                  <div class="event-slide-caption">
                    <span class="event-slide-eyebrow">Obumu collections</span>
                    <h3 class="event-slide-title">Ndejje Primary School Borehole Fundraise</h3>
                    <p class="event-slide-sub">OBUMU is a solution to collect money for problems affecting communities.</p>
                  </div>
                </div>
                
              </div>
              <button class="event-slider-arrow prev" id="eventPrev" aria-label="Previous event">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                  <path d="M12.5 4.5 6 10l6.5 5.5" />
                </svg>
              </button>
              <button class="event-slider-arrow next" id="eventNext" aria-label="Next event">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                  <path d="m7.5 4.5 6.5 5.5-6.5 5.5" />
                </svg>
              </button>
              <div class="event-slider-dots" id="eventDots">
                <button class="event-dot is-active" data-slide="0" aria-label="Go to slide 1"></button>
                <button class="event-dot" data-slide="1" aria-label="Go to slide 2"></button>
                <button class="event-dot" data-slide="2" aria-label="Go to slide 3"></button>
                <button class="event-dot" data-slide="3" aria-label="Go to slide 4"></button>
              </div>
            </div>
            <div class="hero-stat-card glass-card">
              <div class="hero-stat-icon">
                <svg viewBox="0 0 22 22" fill="none">
                  <path d="M11 2a9 9 0 100 18A9 9 0 0011 2Z" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </div>
              <div class="hero-stat-card-text">
                <strong>100% secure</strong>
                <!---<span>MTN &amp; Airtel Money</span> -->
              </div>
            </div>
          </div>
        </div>
      </div>

    </section>

    <partial name="_ObumuStrip" />

    <!-- INTERCEPT -->
    <div class="intercept" id="promise">
      <div class="intercept-inner wrap-xs">
        <h2>Built for communities,<br><em>made for shared goals.</em></h2>
        <p class="intercept-pull">Obumu gives every community a simple, honest way to collect funds and manage pledges
          with full visibility into every payment.</p>
        <a href="http://209.209.42.109:5106/Obumu/Accounts/Register" class="btn btn-blue btn-lg">Create your account</a>
      </div>
    </div>

    <!-- BRIDGE -->
    <section class="bridge-section" id="bridge">
      <div class="wrap bridge-inner">
        <div class="bridge-copy">
          <span class="eyebrow">Why Obumu feels easy</span>
          <h2 class="display-sm">Start a collection. <em>Share it.</em></h2>
          <p class="lead">People join, contribute, and follow progress in one simple place.</p>
          <div class="bridge-points">
            <div class="bridge-point">
              <span class="bridge-point-icon">01</span>
              <strong>Start fast</strong>
              <p>Set up a collection and share it right away.</p>
            </div>
            <div class="bridge-point">
              <span class="bridge-point-icon">02</span>
              <strong>Keep track</strong>
              <p>See pledges and progress in one place.</p>
            </div>
            <div class="bridge-point">
              <span class="bridge-point-icon">03</span>
              <strong>Contribute</strong>
              <p>Send your support with a simple, visible flow.</p>
            </div>
          </div>
        </div>
        <div class="bridge-visual" aria-hidden="true">
          <div class="bridge-visual-frame">
            <img src="/assets/images/obumu_options.png" alt="" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section home-final-cta" id="start">
      <div class="wrap home-final-grid">
        <div class="home-final-start">
          <span class="home-final-pill">Ready?</span>
          <h2>Start your collection <em>today.</em></h2>
          <div class="home-final-people-wrap">
            <img class="home-final-people" src="/assets/images/how_it_works_no_bg.png" alt="An Obumu team member helping community organisers use the platform" loading="lazy" />
          </div>
          <div class="home-final-actions">
            <a href="http://209.209.42.109:5106/Obumu/Accounts/Register" class="btn btn-orange btn-lg">Create your account <span>→</span></a>
            <a href="/HowItWorks" class="btn btn-outline-white btn-lg">See how it works <span>→</span></a>
          </div>
        </div>
        <aside class="home-final-contact" aria-label="Contact Obumu">
          <span class="home-final-kicker">Need a hand?</span>
          <h3>Contact us</h3>
          <div class="home-final-line"></div>
          <div class="home-contact-list">
            <a href="tel:+256200910112"><i aria-hidden="true">☎</i><span><small>Call us</small><strong>0200 910112</strong></span></a>
            <a href="https://wa.me/256743044521" target="_blank" rel="noopener noreferrer"><i aria-hidden="true">✆</i><span><small>Chat on WhatsApp</small><strong>Usually replies in 10 minutes</strong></span></a>
            <a href="mailto:support@obumu.ug"><i aria-hidden="true">✉</i><span><small>Email us</small><strong>support@obumu.ug</strong></span></a>
          </div>
          <div class="home-contact-hours">◷ <span>Support available daily, 9am–5pm</span></div>
        </aside>
      </div>
    </section>

  <partial name="_Footer" />
</body>

</html>
