@page
@model ContactModel
@{
  Layout = null;
  ViewData["Title"] = "Contact Us - Obumu";
  ViewData["ActiveNav"] = "contact";
  ViewData["ObumuStripKey"] = "contact";
}
<!DOCTYPE html>
<html lang="en">

<head>
  <partial name="_Head" />
</head>

<body>

  <partial name="_Nav" />

  <!-- HERO -->
  <section class="hero hero-inner hero-solo contact-hero" style="--hero-img:url('/assets/images/events/education.jpg')">
    <div class="hero-blob"></div>
    <div class="hero-main wrap">
      <div class="hero-left">
        <div class="hero-pill"><span class="pill-dot"></span>We'd love to hear from you</div>
        <h1>We're here to <span>help.</span></h1>
        <p class="hero-sub">
          Questions about a collection, a payment, or partnering with Obumu?
          <strong>Reach out and our team will get back to you.</strong>
        </p>
      </div>
    </div>
  </section>

  <partial name="_ObumuStrip" />

  <!-- BIG BOLD CLAIM -->
  <div class="claim-banner">
    <div class="wrap claim-banner-text">
      Real people. <em>Real support.</em> No forms to fill in.
    </div>
  </div>

  <!-- SUPPORT STATS -->
  <div class="hero-stats">
    <div class="hstat"><span class="hstat-num orange">&lt; 10 min</span><span class="hstat-lbl">Average WhatsApp reply</span></div>
    <div class="hstat"><span class="hstat-num">9am – 5pm</span><span class="hstat-lbl">Support hours, daily</span></div>
    <div class="hstat"><span class="hstat-num orange">4.9 / 5</span><span class="hstat-lbl">Support satisfaction</span></div>
    <div class="hstat"><span class="hstat-num">4</span><span class="hstat-lbl">Ways to reach us</span></div>
  </div>

  <!-- BIG CONTACT PANEL — large, no-form, self-explanatory -->
  <section class="contact-big" style="--big-img:url('/assets/images/events/community&amp;environment.jpg')">
    <div class="contact-big-overlay"></div>
    <div class="wrap contact-big-wrap">

      <div class="contact-big-row">
        <span class="contact-big-label">Call our support line now</span>
        <div class="contact-big-value contact-big-phones">
          <a href="tel:+256200910112">0200 910112</a>
        </div>
      </div>

      <a href="https://wa.me/256743044521" target="_blank" rel="noopener noreferrer" class="contact-big-whatsapp">
        <span class="cbw-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/>
          </svg>
        </span>
        <span class="cbw-text"><strong>WhatsApp</strong> Obumu Support</span>
      </a>

      <div class="contact-big-divider"></div>

      <div class="contact-big-row">
        <span class="contact-big-label">Email</span>
        <a class="contact-big-value contact-big-link" href="mailto:support@obumu.ug">support@obumu.ug</a>
      </div>

      <div class="contact-big-row">
        <span class="contact-big-label">Office</span>
        <span class="contact-big-value">
          Plot 6, 8 Nakasero Hill, Kampala —
          <a class="contact-big-link underline" href="https://www.google.com/maps/search/?api=1&query=Plot+6+8+Nakasero+Hill+Kampala" target="_blank" rel="noopener noreferrer">View map</a>
        </span>
      </div>

      <div class="contact-big-row">
        <span class="contact-big-label">Support hours</span>
        <span class="contact-big-value">Open 9am · Closes 5pm</span>
      </div>

      <div class="contact-big-socials">
        <a href="https://wa.me/256743044521" class="cbs-icon" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/__obumu/" class="cbs-icon" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/IG.jpg" alt="Instagram" />
        </a>
        <a href="https://x.com/_obumu" class="cbs-icon" aria-label="X" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/x_logo.jpg" alt="X" />
        </a>
        <a href="https://www.linkedin.com/company/obumu-innovations/" class="cbs-icon" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/linkedin.webp" alt="LinkedIn" />
        </a>
      </div>
    </div>
  </section>

  <!-- SUPPORT TESTIMONIAL -->
  <section class="trust-section" id="support-story">
    <div class="wrap trust-header" data-r>
      <span class="eyebrow">Support, in the moment it matters</span>
      <h2 class="display-sm" style="text-align:center;margin-bottom:14px;color:#fff">People, not <em>a ticket queue.</em></h2>
      <p style="text-align:center;font-size:1rem;color:rgba(245,200,66,.6)">What it's like to actually reach the Obumu team.</p>
    </div>
    <div class="wrap">
      <div class="trust-heroes">
        <div class="trust-hero glass-card-dark" data-r="l">
          <div class="stars">
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
          </div>
          <p class="trust-hero-quote">"A payment didn't reflect during a burial collection, at night. I messaged
            the WhatsApp line and had a real person looking into it within minutes, not a bot."</p>
          <div class="trust-hero-who">
            <div class="trust-hero-initials">DK</div>
            <div>
              <div class="trust-hero-name">Daniel Kato</div>
              <div class="trust-hero-loc">Mbale</div>
            </div>
          </div>
        </div>
        <div class="trust-hero glass-card-dark" data-r>
          <div class="stars">
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
          </div>
          <p class="trust-hero-quote">"I called the support line about a withdrawal question and got a straight
            answer in under two minutes, no menus, no waiting on hold."</p>
          <div class="trust-hero-who">
            <div class="trust-hero-initials" style="background:var(--orange)">GA</div>
            <div>
              <div class="trust-hero-name">Grace Aciro</div>
              <div class="trust-hero-loc">Lira</div>
            </div>
          </div>
        </div>
        <div class="trust-hero glass-card-dark" data-r="r">
          <div class="stars">
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--orange)"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z"/></svg>
          </div>
          <p class="trust-hero-quote">"Visited the Nakasero office to confirm a payout for a school project. Was
            in and out in fifteen minutes with everything sorted."</p>
          <div class="trust-hero-who">
            <div class="trust-hero-initials" style="background:#1a9e52">MW</div>
            <div>
              <div class="trust-hero-name">Milly Wanyana</div>
              <div class="trust-hero-loc">Kampala</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="contact-faq">
    <div class="wrap-sm">
      <div class="how-header">
        <span class="eyebrow">Before you reach out</span>
        <h2 class="display-sm">Quick answers, right here</h2>
        <p class="lead" style="text-align:center;margin:0 auto;max-width:520px">The questions our support team
          hears most often, so you might not even need to message us.</p>
      </div>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary>
            <span>What's the fastest way to reach Obumu support?</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </summary>
          <p>WhatsApp is the quickest, most replies land within 10 minutes during support hours. For anything
            urgent, our call line 0200 910112 is answered directly by a person, not a menu.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span>My payment isn't showing on my collection, what do I do?</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </summary>
          <p>Message us on WhatsApp with the transaction reference from your mobile money confirmation. Most
            payment mismatches are traced and corrected the same day.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span>Can I get support outside 9am–5pm?</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </summary>
          <p>Our team is online 9am to 5pm daily. Outside those hours, WhatsApp and email messages are still
            received and answered first thing the next morning.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span>Do you offer support for organisations, schools, or churches?</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </summary>
          <p>Yes. Reach out by email at support@obumu.ug and mention your organisation, we set up multi-organiser
            access and walk your team through it directly.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span>Is it worth visiting the office in person?</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </summary>
          <p>Most issues are resolved faster over WhatsApp or phone. The Nakasero office is best for in-person
            payout verification or partnership conversations.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- BANKS & PAYMENT PARTNERS -->
  <section class="banks-marquee-section">
    <div class="wrap">
      <span class="partners-strip-label">Banks &amp; payment channels we work with</span>
      <span class="accent-underline"></span>
    </div>
    <div class="banks-marquee" aria-label="Banks and payment partners">
      <div class="banks-track">
        <div class="bank-badge-logo"><img src="/assets/images/MTN.png" alt="MTN Mobile Money" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/airtel.webp" alt="Airtel Money" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/visa.png" alt="Visa" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/bank_transfer.png" alt="Bank transfer" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/centenarybank_logo.jpg" alt="Centenary Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/stanbic_logo.png" alt="Stanbic Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/DFCU_logo.png" alt="DFCU Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/Absa_Logo.svg" alt="Absa Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/equity-bank_logo.webp" alt="Equity Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/HousingFinance_logo.png" alt="Housing Finance Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/postbank_uganda_ltd_logo.jpg" alt="PostBank Uganda" /></div>
        <!-- duplicate set for seamless loop -->
        <div class="bank-badge-logo"><img src="/assets/images/MTN.png" alt="MTN Mobile Money" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/airtel.webp" alt="Airtel Money" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/visa.png" alt="Visa" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/bank_transfer.png" alt="Bank transfer" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/centenarybank_logo.jpg" alt="Centenary Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/stanbic_logo.png" alt="Stanbic Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/DFCU_logo.png" alt="DFCU Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/Absa_Logo.svg" alt="Absa Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/equity-bank_logo.webp" alt="Equity Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/HousingFinance_logo.png" alt="Housing Finance Bank" /></div>
        <div class="bank-badge-logo"><img src="/assets/images/postbank_uganda_ltd_logo.jpg" alt="PostBank Uganda" /></div>
