@{
  var active = ViewData["ActiveNav"] as string;
  Func<string, string> cls = key => "nav-link" + (active == key ? " on" : "");
}
<!-- NAV glassmorphism -->
<nav class="site-nav" id="snav">
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo">
      <img src="/assets/images/obumu_logo2.png" alt="Obumu" />
    </a>
    <div class="nav-links">
      <a href="/HowItWorks" class='@cls("how")'>How it works</a>
      <a href="/Features" class='@cls("features")'>Features</a>
      <a href="/Download" class='@cls("download")'>Download</a>
      <a href="/Contact" class='@cls("contact")'>Contact</a>
    </div>
    <div class="nav-cta">
      <a href="http://209.209.42.109:5000/Obumu/Accounts/Login" class="btn btn-outline"
         style="padding:10px 20px;font-size:.88rem">Sign in</a>
      <a href="http://209.209.42.109:5000/Obumu/Accounts/Register" class="btn btn-orange"
         style="padding:10px 22px;font-size:.88rem">Get started</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="mobile-menu" id="mmenu">
  <a href="/HowItWorks" class='@cls("how")'>How it works</a>
  <a href="/Features" class='@cls("features")'>Features</a>
  <a href="/Download" class='@cls("download")'>Download</a>
  <a href="/Contact" class='@cls("contact")'>Contact</a>
  <a href="http://209.209.42.109:5000/Obumu/Accounts/Login" class="btn btn-outline btn-full">Sign in</a>
  <a href="http://209.209.42.109:5000/Obumu/Accounts/Register" class="btn btn-orange btn-full">Get started</a>
</div>
