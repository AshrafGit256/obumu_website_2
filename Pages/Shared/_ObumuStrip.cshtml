    }
  };
}

<!-- OBUMU SLIDER -->
<section class="obumu-strip" id="showcase" aria-label="Obumu highlights">
  <div class="wrap obumu-strip-inner">
    <div class="obumu-strip-side obumu-strip-side-prev" id="obumuStripPrev" aria-hidden="true">
      <img class="obumu-strip-side-image" id="obumuStripPrevImage" src="@slides[2].Image" alt="" />
      <div class="obumu-strip-side-copy">
        <span class="obumu-strip-side-kicker">Previous</span>
        <strong id="obumuStripPrevTitle">@slides[2].Title</strong>
        <p id="obumuStripPrevDesc">@slides[2].Desc</p>
      </div>
    </div>
    <div class="obumu-strip-media">
      <img id="obumuStripImage" class="obumu-strip-image is-active" src="@slides[0].Image" alt="@slides[0].Alt" loading="eager" />
    </div>
    <div class="obumu-strip-copy">
      <span class="obumu-strip-kicker">OBUMU</span>
      <h2 class="obumu-strip-title" id="obumuStripTitle">@slides[0].Title</h2>
      <p class="obumu-strip-desc" id="obumuStripDesc">@slides[0].Desc</p>
    </div>
    <div class="obumu-strip-side obumu-strip-side-next" id="obumuStripNext" aria-hidden="true">
      <img class="obumu-strip-side-image" id="obumuStripNextImage" src="@slides[1].Image" alt="" />
      <div class="obumu-strip-side-copy">
        <span class="obumu-strip-side-kicker">Next</span>
        <strong id="obumuStripNextTitle">@slides[1].Title</strong>
        <p id="obumuStripNextDesc">@slides[1].Desc</p>
      </div>
    </div>
    <div class="obumu-strip-slides" id="obumuStripSlides" hidden>
      @foreach (var slide in slides)
      {
        <div data-image="@slide.Image" data-alt="@slide.Alt" data-title="@slide.Title" data-desc="@slide.Desc"></div>
      }
    </div>
  </div>
</section>
