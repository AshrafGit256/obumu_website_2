    {
      new { Image = "/assets/images/obumu_on_mobile.png", Alt = "Obumu on mobile", Title = "Small app", Desc = "Easy to use on lighter phones." },
      new { Image = "/assets/images/people_looking_at_the_phone.png", Alt = "People looking at the phone", Title = "Easy to share", Desc = "Works well on the move." },
      new { Image = "/assets/images/fundraisers.png", Alt = "Fundraisers", Title = "Ready to use", Desc = "Start a collection right away." },
