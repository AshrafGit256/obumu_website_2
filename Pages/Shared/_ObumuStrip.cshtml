      new { Image = "/assets/images/obumu_on_mobile.png", Alt = "Obumu on mobile", Title = "Need help?", Desc = "Reach us from your phone." },
      new { Image = "/assets/images/people_looking_at_the_phone.png", Alt = "People looking at the phone", Title = "Talk to us", Desc = "Ask about your collection." },
