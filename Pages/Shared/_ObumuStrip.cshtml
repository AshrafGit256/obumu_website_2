    },
    "features" => new[]
    {
      new { Image = "/assets/images/obumu_on_mobile.png", Alt = "Obumu on mobile", Title = "Track pledges", Desc = "See promises and payments together." },
      new { Image = "/assets/images/people_looking_at_the_phone.png", Alt = "People looking at the phone", Title = "Share one link", Desc = "Send it through WhatsApp or SMS." },
      new { Image = "/assets/images/fundraisers.png", Alt = "Fundraisers", Title = "Payments stay clear", Desc = "Watch every fundraiser grow live." },
    },
    "how" => new[]
    {
      new { Image = "/assets/images/obumu_on_mobile.png", Alt = "Obumu on mobile", Title = "Start fast", Desc = "Open a collection in minutes." },
      new { Image = "/assets/images/people_looking_at_the_phone.png", Alt = "People looking at the phone", Title = "Invite people", Desc = "Let the group join from any phone." },
      new { Image = "/assets/images/fundraisers.png", Alt = "Fundraisers", Title = "Collect together", Desc = "See the money come in step by step." },
